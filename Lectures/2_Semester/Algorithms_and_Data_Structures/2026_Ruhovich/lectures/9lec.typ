// Лекция 9. Рюкзак (продолжение). СНМ и остовные деревья

#import "../preamble/template.typ": *

#definition[
  Матрица $mat(a, b; c, d)$ *монотонна*, если $(a<=c) -> (b <= d)$
]

#definition[
  Матрица $C_(N times M)$ *монотонна*, если $forall i_1,i_2,j_1,j_2, 1 <= i_1 < i_2 <= N, 1 <= j_1 < j_2 <= M: "матрица" mat(C_(i_1,j_1), C_(i_1,j_2); C_(i_2,j_1), C_(i_2,j_2)) "монотонна"$.
]
